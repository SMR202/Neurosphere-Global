# Set after the production domain is confirmed. Enables canonical URLs.
# Indexing remains disabled until client placeholders and approvals are resolved.
SITE_URL=
# Form access key for the verified NeuroZehn@outlook.com inbox (public alias, not an Outlook password).
# Enable only after the client creates a Web3Forms form and verifies the receiving address.
# Free-plan submissions go from the visitor's browser to Web3Forms after local server validation.
WEB3FORMS_ACCESS_KEY=
# Private HTTPS endpoint accepting JSON {source,form,values}; return 2xx only after accepting delivery.
# The legacy /api/enquiry endpoint uses the previous {source,enquiry} format.
CONTACT_WEBHOOK_URL=
# Kept server-side; sent as Authorization: Bearer <token>.
CONTACT_WEBHOOK_TOKEN=
# Only true if your hosting proxy sanitizes x-forwarded-for. Apply shared edge limits for multiple instances.
TRUST_PROXY=false
