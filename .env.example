# Set after the production domain is confirmed. Enables canonical URLs and indexing.
SITE_URL=
# Private HTTPS endpoint accepting JSON {source,enquiry}; return 2xx only after accepting delivery.
CONTACT_WEBHOOK_URL=
# Kept server-side; sent as Authorization: Bearer <token>.
CONTACT_WEBHOOK_TOKEN=
# Only true if your hosting proxy sanitizes x-forwarded-for. Apply shared edge limits for multiple instances.
TRUST_PROXY=false
